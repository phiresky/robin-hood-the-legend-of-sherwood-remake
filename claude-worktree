#!/bin/bash
set -euo pipefail
name="${1:-}"
if [[ ! "$name" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]]; then
    echo "Usage: claude-worktree <name>"
    echo "Reads agent prompt from stdin."
    exit 1
fi
repo_root="$(git rev-parse --show-toplevel)"
cd -- "$repo_root"
dir=".worktrees/$name"
branch="$name"
base="main"

prompt="$(cat)"
if [ -z "$prompt" ]; then
    echo "Error: no prompt provided on stdin"
    exit 1
fi

if [ -d "$dir" ]; then
    echo "Error: worktree $dir already exists"
    exit 1
fi

git worktree add "$dir" -b "$branch" "$base"
git_common_dir="$(git rev-parse --path-format=absolute --git-common-dir)"
mkdir -p "$dir/.codex"
toml_path_permission() {
    local path=${1//\\/\\\\}
    path=${path//\"/\\\"}
    printf '"%s" = "write"\n' "$path"
}
{
    printf '[permissions.sccache-workspace.filesystem]\n'
    toml_path_permission "$git_common_dir"
    toml_path_permission "${XDG_CACHE_HOME:-$HOME/.cache}/sccache"
    toml_path_permission "${CARGO_HOME:-$HOME/.cargo}"
    toml_path_permission "${XDG_DATA_HOME:-$HOME/.local/share}/robin_hood"
} > "$dir/.codex/config.toml"
if [ "${AGENT:-}" = "codex" ]; then
    cmd="codex $(printf '%q' "$prompt")"
else
    cmd="claude --permission-mode acceptEdits $(printf '%q' "$prompt")"
fi

cmd="systemd-run --user --scope --slice=robin-build.slice --quiet --collect -- $cmd"
tmux new-session -d -s "$name" -c "$(pwd)/$dir" "$cmd"

echo "Started tmux session '$name'"
