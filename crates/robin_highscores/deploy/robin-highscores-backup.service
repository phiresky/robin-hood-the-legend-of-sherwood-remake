[Unit]
Description=Robin Hood complete verified leaderboard backup
After=local-fs.target
ConditionPathIsDirectory=/home/robinhood/.local/share/robin-highscores/backups

[Service]
Type=oneshot
UMask=0077
WorkingDirectory=/home/robinhood/.local/share/robin-highscores
ExecStart=/home/robinhood/.local/opt/robin-highscores/releases/@SOURCE_COMMIT@/bin/robin-highscores-admin --config /home/robinhood/.local/opt/robin-highscores/releases/@SOURCE_COMMIT@/config/highscores-server.toml backup-and-publish-status --release-manifest-path /home/robinhood/.local/opt/robin-highscores/releases/@SOURCE_COMMIT@/vps-release-manifest-v2.json --backup-root /home/robinhood/.local/share/robin-highscores/backups --status-path /home/robinhood/.local/share/robin-highscores/status/backup-status.json --retain-complete 2 --restore-source-map /home/robinhood/.local/share/robin-highscores/api-secrets/cursor-hmac.key=/home/robinhood/.local/share/robin-highscores/api-secrets/cursor-hmac.key --restore-source-map /home/robinhood/.local/share/robin-highscores/api-secrets/competition-run-grant.key=/home/robinhood/.local/share/robin-highscores/api-secrets/competition-run-grant.key --restore-source-map /home/robinhood/.local/share/robin-highscores/api-secrets/run-preflight-grant.key=/home/robinhood/.local/share/robin-highscores/api-secrets/run-preflight-grant.key --restore-source-map /home/robinhood/.local/share/robin-highscores/api-secrets/moderation-bearer.token=/home/robinhood/.local/share/robin-highscores/api-secrets/moderation-bearer.token --restore-source-map /home/robinhood/.config/systemd/user/robin-highscores.target=/home/robinhood/.config/systemd/user/robin-highscores.target --restore-source-map /home/robinhood/.config/systemd/user/robin-highscores-api.service=/home/robinhood/.config/systemd/user/robin-highscores-api.service --restore-source-map /home/robinhood/.config/systemd/user/robin-highscores-worker.service=/home/robinhood/.config/systemd/user/robin-highscores-worker.service --restore-source-map /home/robinhood/.config/systemd/user/robin-highscores-backup.service=/home/robinhood/.config/systemd/user/robin-highscores-backup.service --restore-source-map /home/robinhood/.config/systemd/user/robin-highscores-backup.timer=/home/robinhood/.config/systemd/user/robin-highscores-backup.timer
TimeoutStartSec=6h
Nice=10
IOSchedulingClass=idle
MemoryMax=1G
MemorySwapMax=0
TasksMax=256
LimitNOFILE=8192
NoNewPrivileges=yes
PrivateUsers=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/home/robinhood/.local/opt/robin-highscores/releases/@SOURCE_COMMIT@
ReadOnlyPaths=/home/robinhood/.config/systemd/user/robin-highscores.target
ReadOnlyPaths=/home/robinhood/.config/systemd/user/robin-highscores-api.service
ReadOnlyPaths=/home/robinhood/.config/systemd/user/robin-highscores-worker.service
ReadOnlyPaths=/home/robinhood/.config/systemd/user/robin-highscores-backup.service
ReadOnlyPaths=/home/robinhood/.config/systemd/user/robin-highscores-backup.timer
ReadOnlyPaths=/home/robinhood/.local/share/robin-highscores/api-secrets
ReadOnlyPaths=/home/robinhood/.local/share/robin-highscores/runtime-fence
ReadWritePaths=/home/robinhood/.local/share/robin-highscores/database
ReadWritePaths=/home/robinhood/.local/share/robin-highscores/replays
ReadWritePaths=/home/robinhood/.local/share/robin-highscores/campaign-states
ReadWritePaths=/home/robinhood/.local/share/robin-highscores/backups
ReadWritePaths=/home/robinhood/.local/share/robin-highscores/status
InaccessiblePaths=/home/robinhood/.local/share/robin-highscores/raw-content
SystemCallArchitectures=native
SystemCallFilter=@system-service
