index eefee6b24..807a9c949 100644
--- a/crates/robin_engine/src/sprite.rs
+++ b/crates/robin_engine/src/sprite.rs
@@ -777,6 +777,30 @@ impl Sprite {
         total.min(u16::MAX as u32) as u16
     }
 
+    /// Ticks from an action's START tick until its default-progression
+    /// termination tick, exclusive of the START tick itself.
+    ///
+    /// The frame counter starts one tick behind on the first frame (the
+    /// START tick performs no increment), every subsequent frame consumes
+    /// `delay + 1` increments before advancing, and the animation
+    /// terminates once the counter matches the last frame's delay.  That
+    /// works out to `(frames - 1) + sum(delays)` post-START ticks whether
+    /// or not the last frame's delay is zero.
+    pub fn action_duration_ticks_for_anim(&self, action: OrderType) -> u16 {
+        let Some(row) = self.row_for_action(action) else {
+            return 0;
+        };
+        let scripts = self.current_scripts();
+        let Some(script) = scripts.get(row as usize) else {
+            return 0;
+        };
+        let mut total: u32 = script.frame_ids.len().saturating_sub(1) as u32;
+        for &delay in &script.delays {
+            total = total.saturating_add(delay as u32);
+        }
+        total.min(u16::MAX as u32) as u16
+    }
+
