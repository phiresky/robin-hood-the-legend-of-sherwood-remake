  "door_sources": [
    {
      "doors": [65, 66, 67],
      "owner": "nottingham-castle-gate-arch",
      "node": "building-349",
      "reason": "The three parallel portcullis lanes and their permission control belong to the gateway arch. The courtyard receiving floor supplies their landings but must not carry the gate when moved independently."
    },
    {
      "doors": [
        87,
        88,
        89
      ],
      "owner": "nottingham-castle-hall-and-watchtower",
      "node": "building-378",
      "reason": "These entrances share one interior spanning the hall and its high watchtower. The complete combined asset owns the room, so the tower entrance cannot remain behind when the building moves."
    },
    {
      "doors": [
        33,
        34,
        35,
        36,
        37,
        38
      ],
      "owner": "nottingham-north-gate-gallery",
      "node": "building-184",
      "reason": "These parallel passage lanes cross the opening beneath the north gate gallery. The opening's empty middle lies beyond the solid-geometry ownership radius; all lanes move with the gallery."
    },
    {
      "doors": [
        51,
        52,
        53
      ],
      "owner": "nottingham-village-stream-wall",
      "node": "building-280",
      "reason": "All three parallel passage lanes cross the stream-wall opening. Its empty doorway, rather than the nearby courtyard well, owns this connection."
    },
    {
      "doors": [
        95,
        96,
        97,
        98,
        99
      ],
      "owner": "nottingham-south-gate-arch",
      "node": "building-212",
      "reason": "The five parallel lanes form the south gate arch passage. The arch owns its open span even where a flanking tower is closer to an endpoint."
    },
    {
      "doors": [
        0
      ],
      "owner": "nottingham-market-front-west-green",
      "node": "building-000",
      "reason": "The west green market frontage owns this entrance; its interior waypoint extends behind the split frontage footprint."
    },
    {
      "doors": [
        3
      ],
      "owner": "nottingham-market-front-east-green",
      "node": "building-009",
      "reason": "The east green market frontage owns this entrance; the interior waypoint lies behind its facade rather than on the nearby roof or rear-building footprint."
    },
    {
      "doors": [
        20
      ],
      "owner": "nottingham-north-dormer-house-remainder",
      "node": "building-122",
      "reason": "The inside endpoint is within the dormer house footprint; the neighboring stone house is close enough to fail the generic ownership margin."
    },
    {
      "doors": [
        79,
        80
      ],
      "owner": "nottingham-castle-hall-and-watchtower",
      "node": "building-378",
      "reason": "Both entrances serve the main-hall interior; the upper curtain wall beside the hall does not own this room."
    }
