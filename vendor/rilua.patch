+// Deterministic core VM platform functions -- identical on every target
+// ---------------------------------------------------------------------------
+
+#[allow(unsafe_code)]
+mod deterministic_core {
+    use super::LConv;
+
+    pub(super) static LCONV: LConv = LConv {
+        decimal_point: c".".as_ptr().cast(),
+    };
+
+    pub(crate) unsafe fn localeconv() -> *const LConv {
+        &raw const LCONV
+    }
+
+    pub(crate) unsafe fn strtod(nptr: *const u8, endptr: *mut *mut u8) -> f64 {
+        // SAFETY: the VM supplies a valid NUL-terminated byte string.
+        unsafe {
+            if nptr.is_null() {
+                if !endptr.is_null() {
+                    *endptr = nptr.cast_mut();
+                }
+                return 0.0;
+            }
+            let mut len = 0;
+            while *nptr.add(len) != 0 {
+                len += 1;
+            }
+            let bytes = std::slice::from_raw_parts(nptr, len);
+            let start = bytes
+                .iter()
+                .position(|byte| !byte.is_ascii_whitespace())
+                .unwrap_or(len);
+            let Some(rest) = bytes.get(start..) else {
+                return 0.0;
+            };
+            let Ok(text) = std::str::from_utf8(rest) else {
+                if !endptr.is_null() {
+                    *endptr = nptr.cast_mut();
+                }
+                return 0.0;
+            };
+            let mut parsed = (0, 0.0);
+            for end in (1..=text.len())
+                .rev()
+                .filter(|end| text.is_char_boundary(*end))
+            {
+                if let Ok(value) = text[..end].parse::<f64>() {
+                    parsed = (end, value);
+                    break;
+                }
+            }
+            if !endptr.is_null() {
+                *endptr = nptr.add(start + parsed.0).cast_mut();
+            }
+            parsed.1
+        }
+    }
+
+    pub(crate) unsafe fn strcoll(left: *const u8, right: *const u8) -> i32 {
+        unsafe fn bytes<'a>(pointer: *const u8) -> &'a [u8] {
+            let mut len = 0;
+            // SAFETY: caller provides a valid NUL-terminated string.
+            unsafe {
+                while *pointer.add(len) != 0 {
+                    len += 1;
+                }
+                std::slice::from_raw_parts(pointer, len)
+            }
+        }
+        // SAFETY: inherited from this function's C-compatible contract.
+        match unsafe { bytes(left) }.cmp(unsafe { bytes(right) }) {
+            std::cmp::Ordering::Less => -1,
+            std::cmp::Ordering::Equal => 0,
+            std::cmp::Ordering::Greater => 1,
+        }
+    }
+
+    fn byte(c: i32) -> Option<u8> {
+        u8::try_from(c).ok()
+    }
+
+    macro_rules! classify {
+        ($name:ident, $method:ident) => {
+            pub(crate) unsafe fn $name(c: i32) -> i32 {
+                i32::from(byte(c).is_some_and(|value| value.$method()))
+            }
+        };
+    }
+
+    classify!(isalpha, is_ascii_alphabetic);
+    classify!(iscntrl, is_ascii_control);
+    classify!(isdigit, is_ascii_digit);
+    classify!(islower, is_ascii_lowercase);
+    classify!(ispunct, is_ascii_punctuation);
+    classify!(isspace, is_ascii_whitespace);
+    classify!(isupper, is_ascii_uppercase);
+    classify!(isalnum, is_ascii_alphanumeric);
+    classify!(isxdigit, is_ascii_hexdigit);
+
+    pub(crate) unsafe fn tolower(c: i32) -> i32 {
+        byte(c).map_or(c, |value| i32::from(value.to_ascii_lowercase()))
+    }
+
+    pub(crate) unsafe fn toupper(c: i32) -> i32 {
+        byte(c).map_or(c, |value| i32::from(value.to_ascii_uppercase()))
+    }
+}
+
