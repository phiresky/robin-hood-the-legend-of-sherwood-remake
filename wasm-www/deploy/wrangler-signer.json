{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "robinhood-identity-signer",
  "compatibility_date": "2026-08-30",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "identity.robinhood.phiresky.xyz",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "../signer-dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
